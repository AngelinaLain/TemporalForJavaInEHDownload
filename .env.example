# Copy this file to .env, then fill in every required value.
# .env is ignored by Git. Never commit real credentials or reuse a value from
# a previously committed configuration. Use a randomly generated JWT secret
# of at least 32 bytes and a strong administrator password.

# ── Service discovery and storage ──
NACOS_SERVER_ADDR=
DB_HOST=
DB_PORT=3306
DB_NAME=eh_automation
DB_USERNAME=
DB_PASSWORD=
TEMPORAL_HOST=
TEMPORAL_PORT=7233

# ── Redis（JWT 黑名单 / AI 翻译缓存，可选，未配置则自动降级为内存实现）──
REDIS_HOST=10.10.10.175
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# ── Application security ──
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8002,http://127.0.0.1:8002

# ── EHentai ──
EH_MEMBER_ID=
EH_PASS_HASH=
EH_SK=
EH_STAR=

# ── Proxy ──
PROXY_HOST=
PROXY_PORT=7893
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_TYPE=http

# ── Synology ──
SYNOLOGY_URL=
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
SYNOLOGY_DESTINATION=

# ── Synology SMB/CIFS（本地下载后上传首选，SSH/SFTP 兜底）──
SMB_HOST=
SMB_SHARE=
SMB_PATH=
SMB_USERNAME=
SMB_PASSWORD=
SMB_DOMAIN=

# ── Microsoft Graph notifications ──
NOTIFICATION_ADMIN_EMAIL=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=

# ── Komga ──
KOMGA_URL=
KOMGA_API_KEY=
KOMGA_LIBRARY_ID=

# ── AI service ──
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── 下载模式：local（本地下载+ComicInfo 注入，默认）/ downloadstation（群晖 DownloadStation 兜底）──
DOWNLOAD_MODE=local
# Docker Compose 默认使用持久卷 /data/download-cache；仅在需要绑定其他路径时覆盖。
DOWNLOAD_TEMP_DIR=/data/download-cache

# ── Security / observability ──
## Optional frontend build-time overrides for the provisioned monitoring stack.
# VITE_GRAFANA_URL=http://localhost:3000
# VITE_GRAFANA_DASHBOARD_URL=http://localhost:3000/d/galleryimport-monitoring/galleryimport-monitoring?orgId=1&refresh=30s
# Jasypt 配置加密口令：配置 ${ENC(密文)} 占位符时使用，留空则明文直读
JASYPT_PASSWORD=
# Java 21+ 开启虚拟线程（Java 17 自动忽略）
VIRTUAL_THREADS_ENABLED=false
# Zipkin 链路追踪端点（可观测性 profile 下为 http://zipkin:9411/api/v2/spans）
ZIPKIN_URL=
# 链路采样率：0.0 关闭（默认，本地无 Zipkin 不报错），1.0 全量采样
TRACING_SAMPLE_RATE=0.0
GRAFANA_ADMIN_PASSWORD=
