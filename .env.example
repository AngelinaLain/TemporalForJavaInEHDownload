# 复制本文件为 .env 后再填写配置。.env 已被 Git 忽略，请勿提交真实凭据。
# 标注“必填”的变量必须按部署环境填写；标注“可选”的能力未启用时可以留空。
# 不要复用曾提交到版本库的凭据。JWT 密钥至少使用 32 字节随机值，管理员密码必须使用 BCrypt 哈希。

# ── 服务发现与基础设施（必填）──
# Nacos 地址，例如 nacos.example.com:8848；不要包含 http://。
NACOS_SERVER_ADDR=
# MySQL 连接信息。DB_HOST 只填写主机名或 IP。
DB_HOST=
DB_PORT=3306
DB_NAME=eh_automation
DB_USERNAME=
DB_PASSWORD=
# Temporal Frontend 地址。Docker 网络中通常填写服务名，外部部署填写实际主机。
TEMPORAL_HOST=
TEMPORAL_PORT=7233
# Temporal 空闲长轮询的日志级别。默认 WARN 可隐藏自动重试产生的 70 秒超时堆栈；
# 排查 Temporal 网络连接时临时改为 INFO。
TEMPORAL_POLLER_LOG_LEVEL=WARN

# ── Redis（JWT 黑名单 / AI 翻译缓存，可选，未配置则自动降级为内存实现）──
# Docker Compose 使用 redis；直接在宿主机运行服务时通常改为 localhost。
REDIS_HOST=redis
REDIS_PORT=6379
# Redis 数据库编号。
REDIS_DB=1
REDIS_PASSWORD=

# ── 应用安全（必填）──
# 至少 32 字节的随机字符串；生产环境不得使用示例值或短口令。
JWT_SECRET=
ADMIN_USERNAME=
# BCrypt 哈希（例如 $2a$...），不能填写管理员明文密码。
ADMIN_PASSWORD_HASH=
# 允许访问 API 的前端 Origin，多个值以英文逗号分隔，不要写路径或结尾斜杠。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8002,http://127.0.0.1:8002

# ── EHentai 账号 Cookie（抓取功能必填）──
EH_MEMBER_ID=
EH_PASS_HASH=
EH_SK=
EH_STAR=

# ── 网络代理（可选；目标站点需要代理时填写）──
PROXY_HOST=
PROXY_PORT=7893
PROXY_USERNAME=
PROXY_PASSWORD=
# 支持的类型由底层代理客户端决定，常用值为 http 或 socks。
PROXY_TYPE=http

# ── Synology API / SFTP（使用 Download Station 或作为 SMB 兜底时填写）──
# SYNOLOGY_URL 示例：https://nas.example.com:5001
SYNOLOGY_URL=
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
# NAS 上的目标目录，格式应与当前 Synology 配置保持一致。
SYNOLOGY_DESTINATION=

# ── Synology SMB/CIFS（本地下载后上传首选，SSH/SFTP 兜底）──
# SMB_HOST 只填写主机名或 IP；SMB_SHARE 是共享名；SMB_PATH 是共享内的相对目录。
SMB_HOST=
SMB_SHARE=
SMB_PATH=
SMB_USERNAME=
SMB_PASSWORD=
# 未加入 Windows 域时可以留空。
SMB_DOMAIN=

# ── Microsoft Graph 邮件通知（可选；需要汇总邮件时填写）──
NOTIFICATION_ADMIN_EMAIL=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=

# ── Komga（需要自动入库与元数据同步时填写）──
# KOMGA_URL 示例：http://komga:25600 或 https://komga.example.com
KOMGA_URL=
KOMGA_API_KEY=
KOMGA_LIBRARY_ID=
# 单位：次数 / 秒。默认 40 × 15 秒，最长等待约 10 分钟；约 2 分钟仍未命中时补触发一次扫描。
KOMGA_IMPORT_MAX_RETRIES=40
KOMGA_IMPORT_POLL_INTERVAL_SECONDS=15

# ── AI 服务（启动 ai-service 时必填）──
# OpenAI 兼容接口地址、密钥与模型名。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── 下载模式：local（本地下载+ComicInfo 注入，默认）/ downloadstation（群晖 DownloadStation 兜底）──
DOWNLOAD_MODE=local
# 容器内缓存目录。Docker Compose 默认使用持久卷；失败任务依赖该目录断点续传。
DOWNLOAD_TEMP_DIR=/data/download-cache
# Docker/Linux 直挂归档模式（可选）：ARCHIVE_HOST_PATH 是宿主机看到的 Komga Library 根目录。
# 配置后使用 docker-compose.mount.yml 启动；覆盖文件会自动把容器内 ARCHIVE_MOUNT_PATH 设为
# /data/komga-library，通常不需要手工填写 ARCHIVE_MOUNT_PATH。
ARCHIVE_HOST_PATH=
ARCHIVE_MOUNT_PATH=
# 单位：秒。读取超时表示连接连续无数据的时长，并非整个大文件的下载时限。
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=60
DOWNLOAD_READ_TIMEOUT_SECONDS=120
DOWNLOAD_WRITE_TIMEOUT_SECONDS=60
# 下载失败重试次数及指数退避时间（秒）。
DOWNLOAD_MAX_ATTEMPTS=8
DOWNLOAD_INITIAL_BACKOFF_SECONDS=5
DOWNLOAD_MAX_BACKOFF_SECONDS=120
# 同时运行的单画廊下载数。代理链路不稳定时保持 1；确认带宽充足后最多建议 2。
WORKFLOW_MAX_CONCURRENCY=1
# 单位：分钟。仅 Download Station 模式使用的任务状态轮询间隔。
DOWNLOAD_POLL_INTERVAL_MINUTES=5
# 单位：秒。连续下载任务之间的冷却时间。
DOWNLOAD_COOLDOWN_SECONDS=10

# ── 视觉指纹 ──
# 历史视觉指纹刷新并行度；0 表示由程序根据运行环境自动选择。
VISUAL_FINGERPRINT_PARALLELISM=0

# ── 配置加密与可观测性（可选）──
# 前端构建期 Grafana 地址覆盖；取消注释后需在构建前注入，运行时修改不会重建前端资源。
# VITE_GRAFANA_URL=http://localhost:3000
# VITE_GRAFANA_DASHBOARD_URL=http://localhost:3000/d/galleryimport-monitoring/galleryimport-monitoring?orgId=1&refresh=30s
# Jasypt 配置加密口令：配置 ENC(...) 密文时填写；未使用加密配置则留空。
JASYPT_PASSWORD=
# Java 21+ 可开启虚拟线程；本项目默认 Java 17，设置为 true 也会被自动忽略。
VIRTUAL_THREADS_ENABLED=false
# Zipkin 链路追踪端点；Compose 可观测性 profile 中使用 http://zipkin:9411/api/v2/spans。
ZIPKIN_URL=
# 链路采样率：0.0 关闭，1.0 全量采样。
TRACING_SAMPLE_RATE=0.0
# Grafana 初始管理员密码；启用 observability profile 时应设置强密码。
GRAFANA_ADMIN_PASSWORD=
